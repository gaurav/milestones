{
  "name": "milestones-board-ui",
  "private": true,
  "description": "The front end of `milestones board`. Built into milestones/board/static/, which the Python server serves; the same stack as chaff (github.com/gaurav/triage), so components can move between the two.",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test-ui/**/*.test.ts\"",
    "drive": "node tools/board-check.mjs"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "preact": "^11.0.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
